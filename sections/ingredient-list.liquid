{%- comment -%}
  Ingredient image-and-copy cards. Each block can use an `Ingredient` metaobject
  with image, title, subtitle and description fields, or its own fallback settings.
{%- endcomment -%}

{{ 'offer-sections.css' | asset_url | stylesheet_tag: preload: true }}

{%- liquid
  assign section_settings = section.settings

  if section_settings.background_color != blank
    render 'contrast-override', background_color: section_settings.background_color, section_id: section.id
  endif
-%}

<div
  class="section-background{% if section_settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<div
  class="section section--page-width offer-section ingredient-list spacing-style{% if section_settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    {%- render 'spacing-style', settings: section_settings %}
    --offer-section-surface: {{ section_settings.card_color }};
    --offer-section-ink: {{ section_settings.ink_color }};
    --offer-section-ink-rgb: {{ section_settings.ink_color.rgb }};
    --offer-section-on-ink: {{ section_settings.button_text_color }};
    --offer-section-accent: {{ section_settings.accent_color }};
  "
>
  <div class="offer-section__inner ingredient-list__inner">
    {%- if section_settings.title != blank or section_settings.subtitle != blank -%}
      <header class="offer-section__header ingredient-list__header">
        {%- if section_settings.title != blank -%}
          <h2 class="offer-section__header-copy ingredient-list__title {{ section_settings.heading_preset }}">
            {{ section_settings.title }}
          </h2>
        {%- endif -%}
        {%- if section_settings.subtitle != blank -%}
          <p class="offer-section__header-copy ingredient-list__subtitle">
            {{ section_settings.subtitle | escape }}
          </p>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="ingredient-list__items">
        {%- for block in section.blocks -%}
          {%- liquid
            assign content_reference = block.settings.content_reference

            if content_reference != blank
              assign item_image = content_reference.image.value
              assign item_title = content_reference.title.value
              assign item_subtitle = content_reference.subtitle.value
              assign item_description = content_reference.description
            else
              assign item_image = block.settings.image
              assign item_title = block.settings.title
              assign item_subtitle = block.settings.subtitle
              assign item_description = block.settings.description
            endif
          -%}

          <details
            class="ingredient-list__item{% if item_image == blank %} ingredient-list__item--no-image{% endif %}"
            {{ block.shopify_attributes }}
          >
            <summary class="ingredient-list__summary{% if item_image == blank %} ingredient-list__summary--no-image{% endif %}">
              {%- if item_image != blank -%}
                <span class="offer-section__media">
                  {{
                    item_image
                    | image_url: width: 132
                    | image_tag:
                      loading: 'lazy',
                      widths: '44, 88, 132',
                      sizes: '44px',
                      alt: '',
                      class: 'offer-section__media-image'
                  }}
                </span>
              {%- endif -%}

              <span class="ingredient-list__copy">
                {%- if item_title != blank -%}
                  <span class="offer-section__title ingredient-list__item-title">{{ item_title | escape }}</span>
                {%- endif -%}
                {%- if item_subtitle != blank -%}
                  <span class="ingredient-list__item-subtitle">{{ item_subtitle | escape }}</span>
                {%- endif -%}
              </span>

              <span class="ingredient-list__icon" aria-hidden="true"></span>
            </summary>

            <div class="ingredient-list__content">
              <div class="ingredient-list__content-inner">
                <div class="ingredient-list__description rte">
                  {%- if content_reference != blank -%}
                    {{ item_description | metafield_tag }}
                  {%- else -%}
                    {{ item_description }}
                  {%- endif -%}
                </div>
              </div>
            </div>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {% render 'action-button',
      text: section_settings.button_text,
      action: section_settings.button_action,
      url: section_settings.button_url,
      scroll_target: section_settings.button_scroll_target,
      class: 'offer-section__cta ingredient-list__button'
    %}
  </div>
</div>

{% stylesheet %}
  /*
   * Component styling. Colours, shape, focus, motion and the media and title
   * primitives come from the offer-section library (assets/offer-sections.css);
   * only what is specific to this section lives here.
   */
  .ingredient-list {
    --offer-section-media-size: 2.75rem;
    --offer-section-media-radius: var(--offer-section-radius-pill);
    --offer-section-media-border: var(--offer-section-border-strong);

    --ingredient-list-description-inset: 4.25rem;
  }

  .ingredient-list__title {
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .ingredient-list__subtitle {
    color: var(--offer-section-muted-strong);
    font-size: var(--font-size--sm);
    line-height: 1.4;
  }

  .ingredient-list__items {
    display: grid;
    gap: var(--gap-xs);
  }

  .ingredient-list__item {
    overflow: clip;
    border: var(--style-border-width) solid var(--offer-section-border);
    border-radius: var(--offer-section-radius);
    background-color: var(--offer-section-surface);
  }

  .ingredient-list__summary {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--gap-sm);
    min-height: 4rem;
    padding: var(--padding-xs) var(--padding-sm);
    cursor: pointer;
    list-style: none;
  }

  .ingredient-list__summary--no-image {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .ingredient-list__summary::-webkit-details-marker {
    display: none;
  }

  .ingredient-list__summary:focus-visible {
    outline: var(--offer-section-focus-outline);
    outline-offset: var(--offer-section-focus-offset-inset);
  }

  .ingredient-list__copy {
    display: grid;
    gap: var(--gap-3xs);
    min-width: 0;
  }

  .ingredient-list__item-title,
  .ingredient-list__item-subtitle {
    margin: 0;
    overflow-wrap: break-word;
  }

  .ingredient-list__item-title {
    line-height: 1.15;
  }

  .ingredient-list__item-subtitle {
    color: var(--offer-section-accent);
    font-size: var(--font-size--xs);
    font-weight: 600;
    line-height: 1.25;
  }

  .ingredient-list__icon {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--minimum-touch-target);
    height: var(--minimum-touch-target);
    color: var(--offer-section-accent);
    transform: rotate(0deg);
    transition: transform var(--offer-section-motion) var(--animation-easing);
  }

  .ingredient-list__icon::before,
  .ingredient-list__icon::after {
    position: absolute;
    width: 0.75rem;
    height: 0.1rem;
    background-color: currentcolor;
    content: '';
  }

  .ingredient-list__icon::after {
    transform: rotate(90deg);
  }

  .ingredient-list__item[open] .ingredient-list__icon {
    transform: rotate(45deg);
  }

  .ingredient-list__item::details-content,
  .ingredient-list__content {
    block-size: 0;
    overflow-y: clip;
    opacity: 0;
    interpolate-size: allow-keywords;
    transition: content-visibility var(--offer-section-motion-slow) allow-discrete,
      block-size var(--offer-section-motion-slow) var(--animation-easing),
      opacity var(--offer-section-motion-slow) var(--animation-easing);
  }

  .ingredient-list__item[open]::details-content,
  .ingredient-list__item[open] .ingredient-list__content {
    block-size: auto;
    opacity: 1;

    @starting-style {
      block-size: 0;
      opacity: 0;
    }
  }

  .ingredient-list__description {
    padding-block: 0 var(--padding-md);
    padding-inline: var(--ingredient-list-description-inset) calc(var(--padding-sm) + var(--minimum-touch-target));
    color: var(--offer-section-muted-strong);
    font-size: var(--font-size--sm);
  }

  .ingredient-list__description > :first-child {
    margin-block-start: 0;
  }

  .ingredient-list__description > :last-child {
    margin-block-end: 0;
  }

  .ingredient-list__item--no-image {
    --ingredient-list-description-inset: var(--padding-sm);
  }

  /*
   * The theme's `.button` supplies everything but the colours, which stay wired to
   * this section's settings. The hover pair re-asserts them against `.button:hover`.
   */
  .ingredient-list__button,
  .ingredient-list__button:hover {
    --button-background-color: var(--offer-section-ink);
    --button-color: var(--offer-section-on-ink);
  }

  .ingredient-list__button:hover {
    opacity: var(--opacity-90);
  }

  @media screen and (max-width: 749px) {
    .ingredient-list {
      --offer-section-inner-gap: var(--gap-md);
    }

    .ingredient-list__items {
      gap: var(--gap-2xs);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ingredient list",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "7 Mushrooms. One Mission."
    },
    {
      "type": "select",
      "id": "heading_preset",
      "label": "Title size",
      "options": [
        { "value": "h2", "label": "Large" },
        { "value": "h3", "label": "Medium" },
        { "value": "h4", "label": "Small" }
      ],
      "default": "h3"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Tap any mushroom to learn how it helps."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Start Protecting My Dog's Spine"
    },
    {
      "type": "select",
      "id": "button_action",
      "label": "Button action",
      "options": [
        { "value": "scroll", "label": "Scroll to section" },
        { "value": "link", "label": "Link" }
      ],
      "default": "scroll"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Link",
      "default": "/collections/all",
      "visible_if": "{{ section.settings.button_action == 'link' }}"
    },
    {
      "type": "select",
      "id": "button_scroll_target",
      "label": "Scroll target",
      "options": [
        { "value": "purchase-offers", "label": "Purchase offers" }
      ],
      "default": "purchase-offers",
      "info": "The section on this page the button scrolls to.",
      "visible_if": "{{ section.settings.button_action == 'scroll' }}"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#fff1d2"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Cards",
      "default": "#fffaf0"
    },
    {
      "type": "color",
      "id": "ink_color",
      "label": "Text and button",
      "default": "#2a1f17"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Subtitles and icons",
      "default": "#8a5c2f"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    }
  ],
  "max_blocks": 20,
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "metaobject",
          "id": "content_reference",
          "label": "Ingredient metaobject",
          "metaobject_type": "ingredient",
          "info": "Expected field handles: image, title, subtitle and description. When selected, this entry replaces all content entered below."
        },
        {
          "type": "header",
          "content": "Custom content"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Name"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Short benefit"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredient list",
      "category": "Content",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "title": "Lion's Mane",
            "subtitle": "Nerve Regeneration Powerhouse",
            "description": "<p>Lion's Mane is often featured in wellness blends designed to support focus and everyday nerve health. Describe why it was selected, how much is included, and what makes your source distinctive.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Cordyceps",
            "subtitle": "Muscle Support Guardian",
            "description": "<p>Cordyceps is commonly associated with energy, endurance, and active-day support. Use this area to explain how it complements movement and recovery in your formula.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Chaga",
            "subtitle": "Cellular Defense Shield",
            "description": "<p>Chaga is valued for naturally occurring antioxidant compounds and its role in daily wellness routines. Add details about sourcing, preparation, and how it supports the broader blend.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Reishi",
            "subtitle": "Natural Disc & Nerve Strengthener",
            "description": "<p>Reishi has a long history of use in calming and restorative wellness formulas. Explain how it fits into your product's approach to resilience, rest, or whole-body support.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Turkey Tail",
            "subtitle": "Gut & Immune Protector",
            "description": "<p>Turkey Tail is often included in formulas centered on digestive and immune wellness. Share what makes your extract unique and how it works alongside the other ingredients.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Shiitake & Maitake",
            "subtitle": "Recovery Accelerators",
            "description": "<p>Shiitake and Maitake bring complementary mushroom nutrients to a balanced daily blend. Describe their intended contribution to recovery, vitality, or general wellness.</p>"
          }
        },
        {
          "type": "item",
          "settings": {
            "title": "Turmeric",
            "subtitle": "Inflammation Fighter",
            "description": "<p>Turmeric is widely used in active-lifestyle formulas that support a healthy inflammatory response. Use this space to describe the ingredient form, sourcing, and role in your product.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
