{%- comment -%}
  Purchase section for a product template: subscribe/one-time toggle, 1-4 unit offer
  selection, live pricing, nutrition label modal and add to cart.

  Offers are derived from real product data:
  - a product with multiple variants renders one offer per variant (quantity 1)
  - a single-variant product renders quantity tiers of that variant

  Every price for every offer / selling-plan combination is formatted here in Liquid and
  handed to `purchase-offers.js` as JSON, so the client never does currency math.
{%- endcomment -%}

{{ 'offer-sections.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_settings = section.settings
  assign product_resource = product

  if product_resource == blank and request.visual_preview_mode
    assign product_resource = collections.all.products.first
  endif
-%}

{%- if product_resource == blank -%}
  {%- if request.design_mode -%}
    <div class="section section--page-width purchase-offers">
      <p class="purchase-offers__placeholder">
        {{ 'products.product.unavailable' | t }} — add this section to a product template.
      </p>
    </div>
  {%- endif -%}
{%- else -%}
  {%- liquid
    assign use_currency = settings.currency_code_enabled_product_pages

    # ---------------------------------------------------------------------------
    # Offer source. More than one variant means the merchant has modelled the tub
    # tiers as variants; otherwise fall back to quantity tiers of the only variant.
    # ---------------------------------------------------------------------------
    assign is_variant_mode = false
    if product_resource.variants.size > 1
      assign is_variant_mode = true
    endif

    assign offer_count = section_settings.offer_count
    if is_variant_mode and product_resource.variants.size < offer_count
      assign offer_count = product_resource.variants.size
    endif

    # ---------------------------------------------------------------------------
    # Selling plans. Only the first group is used; a product can belong to several
    # but a single purchase section can only present one subscription offer.
    # ---------------------------------------------------------------------------
    assign plan_group = product_resource.selling_plan_groups.first
    assign selling_plans = plan_group.selling_plans
    assign has_subscription = false
    if selling_plans.size > 0
      assign has_subscription = true
    endif

    assign allow_one_time = true
    if product_resource.requires_selling_plan
      assign allow_one_time = false
    endif

    assign default_plan_key = 'onetime'
    if has_subscription and section_settings.default_plan == 'subscription'
      assign default_plan_key = selling_plans.first.id
    endif
    if has_subscription and allow_one_time == false
      assign default_plan_key = selling_plans.first.id
    endif

    assign days_per_unit = section_settings.days_per_unit
  -%}

  {%- comment -%}
    Pass one: price every offer against every plan, capture the JSON payload, the
    best available saving (for the heading) and the values the summary panel needs
    on first paint.
  {%- endcomment -%}
  {%- liquid
    assign fallback_offer = 0
    assign default_offer = section_settings.default_offer
    if default_offer > offer_count
      assign default_offer = offer_count
    endif
  -%}

  {%- capture offers_json -%}
    [
    {%- for position in (1..offer_count) -%}
      {%- liquid
        if is_variant_mode
          assign offer_variant = product_resource.variants[forloop.index0]
          assign offer_quantity = 1
          assign units = offer_variant.option1 | split: ' ' | first | split: '-' | first | times: 1 | round
          if units < 1
            assign units = forloop.index
          endif
        else
          assign offer_variant = product_resource.selected_or_first_available_variant
          assign offer_quantity = forloop.index
          assign units = forloop.index
        endif

        assign total_days = units | times: days_per_unit

        assign one_time_total = offer_variant.price | times: offer_quantity
        assign one_time_compare = 0
        if offer_variant.compare_at_price > offer_variant.price
          assign one_time_compare = offer_variant.compare_at_price | times: offer_quantity
        endif

        # The single-unit one-time price is the reference every saving is measured
        # against, so a multi-tub offer shows its bundle saving even without a
        # compare-at price on the variant.
        if forloop.first
          assign baseline_unit_price = one_time_total | divided_by: units
        endif

        assign reference_price = baseline_unit_price | times: units
        if one_time_compare > reference_price
          assign reference_price = one_time_compare
        endif

        # The first available offer is used when the configured default is sold out.
        if offer_variant.available and fallback_offer == 0
          assign fallback_offer = forloop.index
        endif
      -%}
      {
      "id": {{ forloop.index }},
      "variantId": {{ offer_variant.id }},
      "quantity": {{ offer_quantity }},
      "available": {% if offer_variant.available %}true{% else %}false{% endif %},
      "plans": {
      {%- assign plan_index = 0 -%}
      {%- for plan in selling_plans -%}
        {%- liquid
          assign allocation = null
          for candidate in offer_variant.selling_plan_allocations
            if candidate.selling_plan_id == plan.id
              assign allocation = candidate
              break
            endif
          endfor
        -%}
        {%- if allocation -%}
          {%- liquid
            assign plan_total = allocation.price | times: offer_quantity
            assign plan_compare = 0
            if allocation.compare_at_price > allocation.price
              assign plan_compare = allocation.compare_at_price | times: offer_quantity
            endif

            assign plan_reference = reference_price
            if plan_compare > plan_reference
              assign plan_reference = plan_compare
            endif

            assign plan_save = 0
            if plan_reference > plan_total
              assign plan_save = plan_reference | minus: plan_total | times: 100 | divided_by: plan_reference | floor
            endif

            assign plan_per_unit = plan_total | divided_by: units
            assign plan_per_day = plan_total | divided_by: total_days

            if use_currency
              assign plan_total_money = plan_total | money_with_currency
              assign plan_compare_money = plan_compare | money_with_currency
              assign plan_per_unit_money = plan_per_unit | money_with_currency
              assign plan_per_day_money = plan_per_day | money_with_currency
            else
              assign plan_total_money = plan_total | money
              assign plan_compare_money = plan_compare | money
              assign plan_per_unit_money = plan_per_unit | money
              assign plan_per_day_money = plan_per_day | money
            endif

            if plan_index > 0
              echo ','
            endif
          -%}
          "{{ plan.id }}": {
          "cents": {{ plan_total }},
          "total": {{ plan_total_money | strip | json }},
          "compareAt": {% if plan_compare > 0 %}{{ plan_compare_money | strip | json }}{% else %}null{% endif %},
          "perUnit": {{ plan_per_unit_money | strip | json }},
          "perDay": {{ plan_per_day_money | strip | json }},
          "save": {{ plan_save }}
          }
          {%- assign plan_index = plan_index | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}

      {%- liquid
        assign one_time_save = 0
        if reference_price > one_time_total
          assign one_time_save = reference_price | minus: one_time_total | times: 100 | divided_by: reference_price | floor
        endif
        assign one_time_per_unit = one_time_total | divided_by: units
        assign one_time_per_day = one_time_total | divided_by: total_days

        if use_currency
          assign one_time_total_money = one_time_total | money_with_currency
          assign one_time_compare_money = one_time_compare | money_with_currency
          assign one_time_per_unit_money = one_time_per_unit | money_with_currency
          assign one_time_per_day_money = one_time_per_day | money_with_currency
        else
          assign one_time_total_money = one_time_total | money
          assign one_time_compare_money = one_time_compare | money
          assign one_time_per_unit_money = one_time_per_unit | money
          assign one_time_per_day_money = one_time_per_day | money
        endif

        if plan_index > 0
          echo ','
        endif
      -%}
      "onetime": {
      "cents": {{ one_time_total }},
      "total": {{ one_time_total_money | strip | json }},
      "compareAt": {% if one_time_compare > 0 %}{{ one_time_compare_money | strip | json }}{% else %}null{% endif %},
      "perUnit": {{ one_time_per_unit_money | strip | json }},
      "perDay": {{ one_time_per_day_money | strip | json }},
      "save": {{ one_time_save }}
      }
      }
      }
      {%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
    ]
  {%- endcapture -%}

  {%- liquid
    # The flagged offer leads the row. Reordering here rather than with CSS `order` keeps
    # DOM order, arrow-key order and visual order in agreement.
    assign most_popular = section_settings.most_popular_offer
    assign leads_with_flag = false
    if most_popular >= 1 and most_popular <= offer_count
      assign leads_with_flag = true
    endif

    assign card_order = ''
    if leads_with_flag
      assign card_order = most_popular | append: ','
    endif
    for position in (1..offer_count)
      unless position == most_popular
        assign card_order = card_order | append: position | append: ','
      endunless
    endfor
    assign card_order = card_order | split: ','

    assign default_variant = product_resource.selected_or_first_available_variant
    if is_variant_mode
      assign default_index = default_offer | minus: 1
      assign default_variant = product_resource.variants[default_index]
    endif

    unless default_variant.available
      assign default_offer = fallback_offer
      if default_offer < 1
        assign default_offer = 1
      endif
      if is_variant_mode
        assign default_index = default_offer | minus: 1
        assign default_variant = product_resource.variants[default_index]
      endif
    endunless

    assign default_quantity = 1
    unless is_variant_mode
      assign default_quantity = default_offer
    endunless

    assign can_add_to_cart = default_variant.available
    assign add_to_cart_text = section_settings.cta_label
    if add_to_cart_text == blank
      assign add_to_cart_text = 'actions.add_to_cart' | t
    endif
    assign sold_out_text = 'products.product.sold_out' | t

    assign form_id = 'PurchaseOffers-' | append: section.id

    # Order total of the default selection, in minor units, for the initial gift state.
    assign default_total_cents = default_variant.price | times: default_quantity
    unless default_plan_key == 'onetime'
      for allocation in default_variant.selling_plan_allocations
        if allocation.selling_plan_id == default_plan_key
          assign default_total_cents = allocation.price | times: default_quantity
          break
        endif
      endfor
    endunless

    # Free gifts come from a metaobject definition. `shop.metaobjects` only exposes
    # definitions whose Storefronts access is enabled, and only published entries, so this
    # is nil rather than an error when either is missing.
    #
    # They unlock cumulatively as the order total passes each threshold, so they are
    # ordered by threshold ascending. Liquid cannot sort drops by a nested field, so
    # thresholds are zero-padded into sortable strings paired with their index.
    assign gift_type = section_settings.gift_metaobject_type | default: 'gift_with_purchase'
    assign gift_definition = shop.metaobjects[gift_type]
    assign gifts = gift_definition.values
    assign gift_order = ''
    for gift in gifts
      assign padded = gift.threshold.value | default: 0 | prepend: '0000000000' | slice: -10, 10
      assign gift_order = gift_order | append: padded | append: '-' | append: forloop.index0 | append: ','
    endfor
    assign gift_order = gift_order | split: ',' | sort
  -%}

  <script
    src="{{ 'purchase-offers.js' | asset_url }}"
    type="module"
  ></script>

  {% render 'add-to-cart-button-styles' %}
  {% render 'fly-to-cart-styles' %}
  {% render 'dialog-styles' %}

  {%- liquid
    if section_settings.background_color != blank
      render 'contrast-override', background_color: section_settings.background_color, section_id: section.id
    endif
  -%}

  <div
    class="section-background{% if section_settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  ></div>

  <purchase-offers-component
    class="section section--page-width offer-section purchase-offers spacing-style{% if section_settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
    data-add-to-cart-text="{{ add_to_cart_text | escape }}"
    data-sold-out-text="{{ sold_out_text | escape }}"
    data-default-plan="{{ default_plan_key }}"
    data-gift-unlocked-label="{{ section_settings.gift_unlocked_label | escape }}"
    data-gift-locked-label="{{ section_settings.gift_locked_label | escape }}"
    style="
      {%- render 'spacing-style', settings: section_settings %}
      --purchase-offers-columns: {{ offer_count }};
      --purchase-offers-columns-rest: {{ offer_count | minus: 1 }};
      {%- if section_settings.surface_color != blank %}
        --purchase-offers-surface: {{ section_settings.surface_color }};
      {%- endif -%}
      {%- if section_settings.ink_color != blank %}
        --purchase-offers-ink: {{ section_settings.ink_color }};
        --purchase-offers-ink-rgb: {{ section_settings.ink_color.rgb }};
      {%- endif -%}
      {%- if section_settings.on_ink_color != blank %}
        --purchase-offers-on-ink: {{ section_settings.on_ink_color }};
      {%- endif -%}
      {%- if section_settings.accent_color != blank %}
        --purchase-offers-accent: {{ section_settings.accent_color }};
        --purchase-offers-accent-rgb: {{ section_settings.accent_color.rgb }};
      {%- endif -%}
    "
    {% if request.visual_preview_mode %}
      data-shopify-visual-preview
    {% endif %}
  >
    <script
      type="application/json"
      ref="offerData"
    >
      {{ offers_json }}
    </script>

    <div class="offer-section__inner purchase-offers__inner">
      <header class="offer-section__header purchase-offers__header">
        {%- if section_settings.subheading != blank -%}
          <p class="offer-section__header-copy purchase-offers__subheading">{{ section_settings.subheading }}</p>
        {%- endif -%}
      </header>

      {%- if has_subscription and allow_one_time -%}
        <fieldset class="purchase-offers__plans">
          <legend class="visually-hidden">{{ section_settings.plan_legend }}</legend>
          {%- comment -%}
            Decorative sliding fill. The checked radio drives its position, so it tracks
            keyboard and pointer selection alike without any JavaScript.
          {%- endcomment -%}
          <span
            class="purchase-offers__plans-thumb"
            aria-hidden="true"
          ></span>
          {%- for plan_option in (1..2) -%}
            {%- liquid
              if forloop.first
                assign plan_value = selling_plans.first.id
                assign plan_label = section_settings.subscribe_label
                assign plan_note = section_settings.subscribe_note
              else
                assign plan_value = 'onetime'
                assign plan_label = section_settings.one_time_label
                assign plan_note = ''
              endif
            -%}
            <label class="purchase-offers__plan">
              <input
                type="radio"
                class="purchase-offers__plan-input"
                name="purchase-offers-plan-{{ section.id }}"
                value="{{ plan_value }}"
                ref="planInputs[]"
                on:change="purchase-offers-component/handlePlanChange"
                {% if plan_value == default_plan_key %}
                  checked
                {% endif %}
              >
              <span class="purchase-offers__plan-inner">
                <span class="purchase-offers__plan-label">{{ plan_label }}</span>
                {%- if plan_note != blank -%}
                  <span class="purchase-offers__plan-note">{{ plan_note }}</span>
                {%- endif -%}
              </span>
            </label>
          {%- endfor -%}
        </fieldset>
      {%- endif -%}

      <fieldset class="purchase-offers__offers">
        <legend class="visually-hidden">{{ section_settings.offers_legend }}</legend>
        <div class="purchase-offers__cards{% if leads_with_flag %} purchase-offers__cards--lead{% endif %}">
          {%- for card_position in card_order -%}
            {%- liquid
              assign offer_index = card_position | times: 1
              assign variant_index = offer_index | minus: 1
              assign card_has_count = true

              if is_variant_mode
                assign card_variant = product_resource.variants[variant_index]
                assign card_label = card_variant.option1 | default: card_variant.title
                assign card_units = card_variant.option1 | split: ' ' | first | split: '-' | first | times: 1 | round
                # An option value with no leading number ("Trial size") has no count to show,
                # so the card falls back to the option value itself.
                if card_units < 1
                  assign card_units = offer_index
                  assign card_has_count = false
                endif
              else
                assign card_variant = product_resource.selected_or_first_available_variant
                assign card_units = offer_index
                if card_units == 1
                  assign card_label = card_units | append: ' ' | append: section_settings.unit_label_singular
                else
                  assign card_label = card_units | append: ' ' | append: section_settings.unit_label_plural
                endif
              endif

              assign card_unit_label = section_settings.unit_label_plural
              if card_units == 1
                assign card_unit_label = section_settings.unit_label_singular
              endif

              assign card_image = card_variant.featured_media.preview_image | default: product_resource.featured_image
              assign is_most_popular = false
              if most_popular == offer_index
                assign is_most_popular = true
              endif
            -%}
            <label class="purchase-offers__card">
              <input
                type="radio"
                class="purchase-offers__card-input"
                name="purchase-offers-offer-{{ section.id }}"
                value="{{ offer_index }}"
                ref="offerInputs[]"
                aria-label="{{ card_label }}{% unless card_variant.available %} - {{ 'products.product.sold_out' | t }}{% endunless %}"
                on:change="purchase-offers-component/handleOfferChange"
                {% if offer_index == default_offer %}
                  checked
                {% endif %}
                {% unless card_variant.available %}
                  disabled
                {% endunless %}
              >
              {%- if is_most_popular and section_settings.most_popular_label != blank -%}
                <span class="purchase-offers__flag">{{ section_settings.most_popular_label }}</span>
              {%- endif -%}
              <span class="purchase-offers__card-inner">
                {%- if section_settings.show_card_images and card_image -%}
                  {{
                    card_image
                    | image_url: width: 320
                    | image_tag:
                      loading: 'lazy',
                      widths: '120, 200, 320',
                      sizes: '(min-width: 750px) 160px, 40vw',
                      alt: '',
                      class: 'purchase-offers__card-image'
                  }}
                {%- endif -%}
                {%- if card_has_count -%}
                  <span class="purchase-offers__card-count">{{ card_units }}</span>
                  <span class="purchase-offers__card-unit">{{ card_unit_label }}</span>
                {%- else -%}
                  <span class="purchase-offers__card-unit">{{ card_label }}</span>
                {%- endif -%}
                {%- if section_settings.show_card_savings -%}
                  <span
                    class="purchase-offers__card-savings"
                    ref="cardSavings[]"
                    data-offer-id="{{ offer_index }}"
                    data-template="{{ section_settings.card_savings_label | escape }}"
                    hidden
                  ></span>
                {%- endif -%}
                {%- unless card_variant.available -%}
                  <span class="purchase-offers__card-unavailable">{{ 'products.product.sold_out' | t }}</span>
                {%- endunless -%}
              </span>
            </label>
          {%- endfor -%}
        </div>
      </fieldset>

      {%- if has_subscription and selling_plans.size > 1 -%}
        <div
          class="purchase-offers__frequency"
          ref="frequencyField"
          {% if default_plan_key == 'onetime' %}
            hidden
          {% endif %}
        >
          <label
            class="purchase-offers__frequency-label"
            for="PurchaseOffersFrequency-{{ section.id }}"
          >
            {{ section_settings.frequency_label }}
          </label>
          <select
            id="PurchaseOffersFrequency-{{ section.id }}"
            class="purchase-offers__frequency-select"
            ref="frequency"
            on:change="purchase-offers-component/handlePlanChange"
          >
            {%- for plan in selling_plans -%}
              <option value="{{ plan.id }}">{{ plan.name }}</option>
            {%- endfor -%}
          </select>
        </div>
      {%- endif -%}

      <div class="purchase-offers__summary">
        <div class="purchase-offers__summary-detail">
          <p
            class="purchase-offers__savings"
            ref="summarySavings"
            data-template="{{ section_settings.savings_label | escape }}"
            hidden
          ></p>
          <p class="purchase-offers__per-unit">
            <span
              class="purchase-offers__per-unit-price"
              ref="summaryPerUnit"
            ></span>
            <span class="purchase-offers__per-unit-suffix">
              {{- section_settings.per_unit_label | replace: '[unit]', section_settings.unit_label_singular -}}
            </span>
          </p>
          <p class="purchase-offers__per-day">
            <span aria-hidden="true">~</span>
            <span ref="summaryPerDay"></span>
            {{ section_settings.per_day_label }}
          </p>
        </div>
        <div class="purchase-offers__summary-total">
          <p class="purchase-offers__total-label">{{ section_settings.total_label }}</p>
          <p class="purchase-offers__total-value">
            <s
              class="purchase-offers__compare-at"
              ref="summaryCompareAt"
              hidden
            ></s>
            <span ref="summaryTotal"></span>
          </p>
        </div>
      </div>

      {%- if gifts.size > 0 -%}
        {%- liquid
          assign gift_count = gifts.size

          assign note_subscription = section_settings.gifts_note_subscription | replace: '[count]', gift_count
          assign note_one_time = section_settings.gifts_note_one_time | replace: '[count]', gift_count
          assign note_no_subscription = section_settings.gifts_note_no_subscription | replace: '[count]', gift_count

          unless has_subscription
            assign note_subscription = note_no_subscription
            assign note_one_time = note_no_subscription
          endunless

          if default_plan_key == 'onetime'
            assign note_initial = note_one_time
          else
            assign note_initial = note_subscription
          endif
        -%}
        <div class="purchase-offers__gifts">
          {%- if note_initial != blank -%}
            <p
              class="purchase-offers__note"
              ref="giftsNote"
              data-subscription-note="{{ note_subscription | escape }}"
              data-one-time-note="{{ note_one_time | escape }}"
            >
              {{ note_initial }}
            </p>
          {%- endif -%}

          <ul
            class="purchase-offers__gift-list"
            role="list"
          >
            {%- for entry in gift_order -%}
              {%- liquid
                assign gift_index = entry | split: '-' | last | times: 1
                assign gift = gifts[gift_index]
                assign gift_threshold = gift.threshold.value | default: 0
                assign gift_image = gift.image.value

                assign gift_subscription_only = false
                if gift.subscription_only.value
                  assign gift_subscription_only = true
                endif

                # Server-rendered state matches the default selection so the panel is
                # correct before the component hydrates.
                assign gift_unlocked = false
                if default_total_cents >= gift_threshold
                  assign gift_unlocked = true
                endif
                if gift_subscription_only and default_plan_key == 'onetime'
                  assign gift_unlocked = false
                endif
              -%}
              <li
                class="purchase-offers__gift"
                ref="gifts[]"
                data-threshold="{{ gift_threshold }}"
                data-subscription-only="{{ gift_subscription_only }}"
                data-unlocked="{{ gift_unlocked }}"
              >
                <span class="purchase-offers__gift-media">
                  {%- if gift_image -%}
                    {{
                      gift_image
                      | image_url: width: 400
                      | image_tag:
                        loading: 'lazy',
                        widths: '120, 200, 400',
                        sizes: '(min-width: 750px) 160px, 30vw',
                        alt: '',
                        class: 'purchase-offers__gift-image'
                    }}
                  {%- endif -%}
                </span>
                {%- if gift.title.value != blank -%}
                  <span class="purchase-offers__gift-title">{{ gift.title.value }}</span>
                {%- endif -%}
                {%- if gift.subtitle.value != blank -%}
                  <span class="purchase-offers__gift-subtitle">{{ gift.subtitle.value }}</span>
                {%- endif -%}
                <span
                  class="visually-hidden"
                  ref="giftStatuses[]"
                >
                  {%- if gift_unlocked -%}
                    {{ section_settings.gift_unlocked_label }}
                  {%- else -%}
                    {{ section_settings.gift_locked_label }}
                  {%- endif -%}
                </span>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- elsif request.design_mode -%}
        {%- comment -%}
          Only merchants in the theme editor see this; the storefront stays silent.
        {%- endcomment -%}
        <p class="purchase-offers__gifts-empty">
          {%- if gift_definition == blank -%}
            No metaobject definition named
            <strong>{{ gift_type }}</strong>
            is visible to this theme. Check the type handle above, and make sure the definition has
            Storefronts access enabled in Settings &rarr; Custom data.
          {%- else -%}
            The
            <strong>{{ gift_type }}</strong>
            definition was found but has no published entries. Draft entries are not shown.
          {%- endif -%}
        </p>
      {%- endif -%}

      {%- if section_settings.show_nutrition_label -%}
        <dialog-component class="purchase-offers__nutrition">
          <button
            type="button"
            class="button-unstyled purchase-offers__nutrition-button"
            on:click="/showDialog"
          >
            {{- section_settings.nutrition_label_text -}}
            <span class="svg-wrapper">{{- 'icon-external.svg' | inline_asset_content -}}</span>
          </button>

          <dialog
            ref="dialog"
            class="purchase-offers__nutrition-dialog dialog-modal color-custom-popover"
            scroll-lock
            aria-labelledby="PurchaseOffersNutrition-{{ section.id }}"
          >
            <h3
              id="PurchaseOffersNutrition-{{ section.id }}"
              class="purchase-offers__nutrition-heading h5"
            >
              {{ section_settings.nutrition_heading }}
            </h3>
            {%- if section_settings.nutrition_image != blank -%}
              {{
                section_settings.nutrition_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 700, 1000, 1200',
                  sizes: '(min-width: 750px) 600px, 90vw',
                  alt: section_settings.nutrition_heading,
                  class: 'purchase-offers__nutrition-image'
              }}
            {%- endif -%}
            {%- if section_settings.nutrition_content != blank -%}
              <div class="purchase-offers__nutrition-content rte">{{ section_settings.nutrition_content }}</div>
            {%- endif -%}
            <button
              ref="closeButton"
              type="button"
              class="button-unstyled close-button purchase-offers__nutrition-close"
              on:click="/closeDialog"
              aria-label="{{ 'accessibility.close_dialog' | t }}"
            >
              {{- 'icon-close.svg' | inline_asset_content -}}
            </button>
          </dialog>
        </dialog-component>
      {%- endif -%}

      <product-form-component
        data-section-id="{{ section.id }}"
        data-product-id="{{ product_resource.id }}"
        data-product-url="{{ product_resource.url }}"
        data-quantity-default="{{ default_quantity }}"
        data-quantity-error-max="{{ 'products.product.quantity_error_max' | t }}"
        on:submit="/handleSubmit"
      >
        <div
          class="visually-hidden"
          aria-live="assertive"
          role="status"
          aria-atomic="true"
          ref="liveRegion"
        ></div>

        {%- form 'product', product_resource, id: form_id, data-type: 'add-to-cart-form' -%}
          <input
            type="hidden"
            name="id"
            ref="variantId"
            value="{{ default_variant.id }}"
          >
          <input
            type="hidden"
            name="quantity"
            value="{{ default_quantity }}"
          >
          {%- if has_subscription -%}
            <input
              type="hidden"
              name="selling_plan"
              value="{% unless default_plan_key == 'onetime' %}{{ default_plan_key }}{% endunless %}"
              {% if default_plan_key == 'onetime' %}
                disabled
              {% endif %}
            >
          {%- endif -%}

          <div class="product-form-buttons purchase-offers__buttons">
            <span
              class="product-form-text__error hidden"
              ref="addToCartTextError"
            >
              <span class="svg-wrapper">{{- 'icon-error.svg' | inline_asset_content -}}</span>
            </span>

            {%- comment -%}
              Mirrors snippets/add-to-cart-button.liquid, with the label wrapped so the
              selected offer's availability can swap it without touching the icon markup.
            {%- endcomment -%}
            {%- liquid
              assign button_media = default_variant.featured_media.preview_image | default: product_resource.featured_media.preview_image
              assign button_media_url = button_media | image_url: width: 100
            -%}
            <add-to-cart-component
              ref="addToCartButtonContainer"
              data-product-variant-media="{{ button_media_url }}"
              data-add-to-cart-animation="{{ settings.add_to_cart_animation }}"
            >
              <button
                id="PurchaseOffers-Submit-{{ section.id }}"
                type="submit"
                name="add"
                ref="addToCartButton"
                on:click="/handleClick"
                class="button add-to-cart-button offer-section__cta purchase-offers__cta"
                {% unless can_add_to_cart %}
                  disabled
                {% endunless %}
              >
                <span data-cta-label>
                  {%- if can_add_to_cart -%}{{ add_to_cart_text }}{%- else -%}{{ sold_out_text }}{%- endif -%}
                </span>
                <span class="add-to-cart__added">
                  <span class="svg-wrapper add-to-cart__added-icon">
                    {{- 'icon-checkmark-burst.svg' | inline_asset_content -}}
                  </span>
                </span>
              </button>
            </add-to-cart-component>
          </div>
        {%- endform -%}
      </product-form-component>

      {%- if section_settings.guarantee_text != blank -%}
        <p class="purchase-offers__guarantee">
          <span class="svg-wrapper">{{- 'icon-checkmark.svg' | inline_asset_content -}}</span>
          {{ section_settings.guarantee_text }}
        </p>
      {%- endif -%}

      {%- if section_settings.supporting_text != blank -%}
        <div class="purchase-offers__supporting rte">{{ section_settings.supporting_text }}</div>
      {%- endif -%}
    </div>
  </purchase-offers-component>
{%- endif -%}

{% stylesheet %}
  .purchase-offers {
    /* Overridden per section by the colour settings; these are the design defaults. */
    --purchase-offers-surface: #fdf1de;
    --purchase-offers-ink: #2a1f17;
    --purchase-offers-ink-rgb: 42 31 23;
    --purchase-offers-on-ink: #ffffff;
    --purchase-offers-accent: #b98a4b;
    --purchase-offers-accent-rgb: 185 138 75;

    --purchase-offers-muted: rgb(var(--purchase-offers-ink-rgb) / 0.62);
    --purchase-offers-radius: var(--style-border-radius-lg);
    --purchase-offers-radius-pill: 999px;

    /* Gap between the toggle track and the fill that slides inside it. */
    --purchase-offers-track-padding: var(--padding-2xs);
    /* Width of the flagged offer relative to the others, floored at its flag's width. */
    --purchase-offers-lead-flex: 1.3fr;
    /* Inset of the toggle from the surrounding content. */
    --purchase-offers-track-inset: var(--margin-2xl);
  }

  @media screen and (min-width: 750px) {
    .purchase-offers {
      --purchase-offers-track-inset: var(--margin-6xl);
    }
  }

  .purchase-offers [hidden] {
    display: none !important;
  }

  /*
   * The radios stay focusable but invisible. `.visually-hidden` is not used here
   * because it un-hides on focus, which would reveal a native radio on top of
   * the control it drives.
   */
  .purchase-offers__plan-input,
  .purchase-offers__card-input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .purchase-offers__placeholder {
    padding-block: var(--padding-4xl);
    text-align: center;
  }

  .purchase-offers__inner {
    display: grid;
    gap: var(--gap-lg);
    margin-inline: auto;
    width: 100%;
    max-width: 34rem;
    color: var(--purchase-offers-ink);
  }

  .purchase-offers__header {
    display: grid;
    gap: var(--gap-2xs);
    text-align: center;
  }

  .purchase-offers__subheading {
    margin: 0;
  }

  .purchase-offers__subheading {
    font-family: var(--font-heading--family);
    font-size: var(--font-size--xl);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  /* Subscribe & save / one-time segmented control */
  .purchase-offers__plans {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    position: relative;
    margin-block: var(--margin-2xs);
    margin-inline: var(--purchase-offers-track-inset);
    border: 0;
    padding: var(--purchase-offers-track-padding);
    border-radius: var(--purchase-offers-radius-pill);
    background-color: var(--purchase-offers-surface);
  }

  /*
   * Exactly one half of the track's content box, so translating it by its own
   * width lands it precisely over the second option.
   */
  .purchase-offers__plans-thumb {
    position: absolute;
    z-index: 0;
    inset-block: var(--purchase-offers-track-padding);
    inset-inline-start: var(--purchase-offers-track-padding);
    width: calc((100% - var(--purchase-offers-track-padding) * 2) / 2);
    border-radius: var(--purchase-offers-radius-pill);
    background-color: var(--purchase-offers-ink);
  }

  .purchase-offers__plans:has(.purchase-offers__plan:last-of-type .purchase-offers__plan-input:checked)
    .purchase-offers__plans-thumb {
    transform: translateX(100%);
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    .purchase-offers__plans-thumb {
      transition: transform var(--animation-speed-slow) var(--ease-out-quad);
    }

    .purchase-offers__plan-inner {
      transition: color var(--animation-speed) var(--animation-easing);
    }
  }

  /*
   * base.css styles `label:has(input[type='radio'])` as inline-flex (specificity 0,1,2).
   * These need two classes to outrank it, otherwise the inner span becomes a flex item
   * and shrinks to its text instead of filling the half.
   */
  .purchase-offers .purchase-offers__plan {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
  }

  /*
   * Two rows: a zero-height one the flag overflows out of, and the fill. The flag still
   * contributes its width to the card's intrinsic size — so the lead track grows to
   * contain it — while contributing no height, leaving every card the same height.
   */
  .purchase-offers .purchase-offers__card {
    display: grid;
    grid-template-rows: 0 1fr;
    align-items: stretch;
    gap: 0;
  }

  .purchase-offers__plan {
    position: relative;
    z-index: 1;
    cursor: pointer;
  }

  .purchase-offers__plan-inner {
    display: grid;
    gap: var(--gap-3xs);
    justify-items: center;
    padding-block: var(--padding-xs);
    padding-inline: var(--padding-xs);
    border-radius: var(--purchase-offers-radius-pill);
    text-align: center;
  }

  .purchase-offers__plan-label {
    font-size: var(--font-size--sm);
    font-weight: 600;
  }

  .purchase-offers__plan-note {
    font-size: var(--font-size--2xs);
    color: var(--purchase-offers-muted);
  }

  .purchase-offers__plan-input:checked ~ .purchase-offers__plan-inner {
    color: var(--purchase-offers-on-ink);
  }

  .purchase-offers__plan-input:checked ~ .purchase-offers__plan-inner .purchase-offers__plan-note {
    color: rgb(255 255 255 / var(--opacity-70));
  }

  .purchase-offers__plan-input:focus-visible ~ .purchase-offers__plan-inner {
    outline: var(--focus-outline-width) solid var(--purchase-offers-ink);
    outline-offset: var(--focus-outline-offset);
  }

  /* Offer cards */
  .purchase-offers__offers {
    margin: 0;
    border: 0;
    padding: 0;
  }

  .purchase-offers__cards {
    display: grid;
    grid-template-columns: repeat(var(--purchase-offers-columns, 4), minmax(0, 1fr));
    gap: var(--gap-xs);
  }

  /*
   * The flagged offer leads and takes an `auto` track, so it is sized by its own
   * max-content — which includes the flag, since the flag is in flow. The remaining
   * tracks share what is left and shrink to accommodate it.
   */
  .purchase-offers__cards--lead {
    grid-template-columns:
      minmax(max-content, var(--purchase-offers-lead-flex, 1.3fr))
      repeat(var(--purchase-offers-columns-rest, 3), minmax(0, 1fr));
  }

  .purchase-offers__card {
    position: relative;
    cursor: pointer;
  }

  .purchase-offers__card:has(.purchase-offers__card-input:disabled) {
    cursor: not-allowed;
    opacity: var(--opacity-50);
  }

  .purchase-offers__card-inner {
    display: grid;
    gap: var(--gap-3xs);
    align-content: center;
    justify-items: center;
    grid-row: 2;
    padding: var(--padding-md) var(--padding-2xs);
    border-radius: var(--purchase-offers-radius);
    background-color: var(--purchase-offers-surface);
    text-align: center;
    transition: background-color var(--animation-speed) var(--animation-easing),
      color var(--animation-speed) var(--animation-easing);
  }

  .purchase-offers__card-input:checked ~ .purchase-offers__card-inner {
    background-color: var(--purchase-offers-ink);
    color: var(--purchase-offers-on-ink);
  }

  .purchase-offers__card-input:focus-visible ~ .purchase-offers__card-inner {
    outline: var(--focus-outline-width) solid var(--purchase-offers-ink);
    outline-offset: var(--focus-outline-offset);
  }

  .purchase-offers__card-count {
    font-size: var(--font-size--xl);
    font-weight: 700;
    line-height: 1.1;
  }

  .purchase-offers__card-unit {
    color: var(--purchase-offers-muted);
    font-size: var(--font-size--2xs);
    line-height: 1.2;
  }

  .purchase-offers__card-input:checked ~ .purchase-offers__card-inner .purchase-offers__card-unit {
    color: rgb(255 255 255 / var(--opacity-70));
  }

  /* Straddles the card's top edge, out of the zero-height first row. */
  .purchase-offers__flag {
    grid-row: 1;
    justify-self: center;
    /* Without this the flag stretches to the zero-height row and its text spills out. */
    align-self: start;
    z-index: 1;
    transform: translateY(-50%);
    width: fit-content;
    padding: var(--padding-3xs) var(--padding-xs);
    border-radius: var(--purchase-offers-radius-pill);
    background-color: var(--purchase-offers-accent);
    color: var(--purchase-offers-on-ink);
    font-size: var(--font-size--3xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.4;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .purchase-offers__card-image {
    width: 100%;
    max-width: 4rem;
    height: auto;
    object-fit: contain;
  }

  .purchase-offers__card-savings {
    color: var(--purchase-offers-accent);
    font-size: var(--font-size--2xs);
    font-weight: 600;
  }

  .purchase-offers__card-unavailable {
    color: var(--purchase-offers-muted);
    font-size: var(--font-size--2xs);
  }

  /* Delivery frequency */
  .purchase-offers__frequency {
    display: grid;
    gap: var(--gap-2xs);
  }

  .purchase-offers__frequency-label {
    font-size: var(--font-size--sm);
  }

  .purchase-offers__frequency-select {
    width: 100%;
    padding: var(--padding-sm) var(--padding-md);
    border: 0;
    border-radius: var(--purchase-offers-radius);
    background-color: var(--purchase-offers-surface);
    color: var(--purchase-offers-ink);
    font-size: var(--font-size--sm);
  }

  /* Price summary */
  .purchase-offers__summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--gap-md);
    padding: var(--padding-lg);
    border-radius: var(--purchase-offers-radius);
    background-color: var(--purchase-offers-surface);
  }

  .purchase-offers__summary p {
    margin: 0;
  }

  .purchase-offers__summary-detail {
    display: grid;
    gap: var(--gap-3xs);
  }

  .purchase-offers__savings,
  .purchase-offers__per-day,
  .purchase-offers__total-label {
    color: var(--purchase-offers-muted);
    font-size: var(--font-size--xs);
  }

  .purchase-offers__per-unit {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--gap-2xs);
  }

  .purchase-offers__per-unit-price {
    font-size: var(--font-size--2xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .purchase-offers__per-unit-suffix {
    font-size: var(--font-size--sm);
    font-weight: 500;
  }

  .purchase-offers__summary-total {
    display: grid;
    gap: var(--gap-3xs);
    justify-items: end;
    text-align: end;
  }

  .purchase-offers__total-value {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: flex-end;
    gap: var(--gap-2xs);
    color: var(--purchase-offers-accent);
    font-size: var(--font-size--xl);
    font-weight: 700;
    line-height: 1.2;
  }

  .purchase-offers__compare-at {
    color: var(--purchase-offers-muted);
    font-size: var(--font-size--xs);
    font-weight: 400;
  }

  .purchase-offers__gifts-empty {
    margin: 0;
    padding: var(--padding-md);
    border: 1px dashed rgb(var(--purchase-offers-ink-rgb) / var(--opacity-30));
    border-radius: var(--purchase-offers-radius);
    color: var(--purchase-offers-muted);
    font-size: var(--font-size--xs);
    text-align: center;
  }

  .purchase-offers__gifts {
    display: grid;
    gap: var(--gap-md);
    padding: var(--padding-lg);
    border-radius: var(--purchase-offers-radius);
    background-color: rgb(var(--purchase-offers-accent-rgb) / var(--opacity-10));
  }

  .purchase-offers__gift-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    gap: var(--gap-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .purchase-offers__gift {
    display: grid;
    gap: var(--gap-3xs);
    justify-items: center;
    text-align: center;
  }

  /* Locked gifts stay legible but visibly out of reach. */
  .purchase-offers__gift[data-unlocked='false'] {
    opacity: var(--opacity-50);
    filter: grayscale(1);
  }

  @media screen and (prefers-reduced-motion: no-preference) {
    .purchase-offers__gift {
      transition: opacity var(--animation-speed-slow) var(--animation-easing),
        filter var(--animation-speed-slow) var(--animation-easing);
    }
  }

  .purchase-offers__gift-media {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    margin-block-end: var(--margin-2xs);
    border-radius: var(--purchase-offers-radius);
    background-color: var(--purchase-offers-surface);
    overflow: hidden;
  }

  .purchase-offers__gift-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .purchase-offers__gift-title {
    font-size: var(--font-size--xs);
    font-weight: 600;
    line-height: 1.3;
  }

  .purchase-offers__gift-subtitle {
    color: var(--purchase-offers-muted);
    font-size: var(--font-size--2xs);
    line-height: 1.3;
  }

  .purchase-offers__note {
    margin: 0;
    color: var(--purchase-offers-accent);
    font-size: var(--font-size--sm);
    font-weight: 600;
    text-align: center;
  }

  /* Nutrition label */
  .purchase-offers__nutrition {
    display: block;
    text-align: center;
  }

  .purchase-offers__nutrition-button {
    display: inline-flex;
    align-items: center;
    gap: var(--gap-2xs);
    font-size: var(--font-size--sm);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .purchase-offers__nutrition-dialog {
    position: relative;
    max-height: var(--modal-max-height, 90dvh);
    padding: var(--padding-4xl) var(--padding-xl) var(--padding-xl);
    border-radius: var(--style-border-radius-popover);
    background-color: var(--color-background);
    color: var(--color-foreground);
    overflow-y: auto;
  }

  .purchase-offers__nutrition-heading {
    margin-block: 0 var(--margin-lg);
  }

  .purchase-offers__nutrition-image {
    display: block;
    width: 100%;
    height: auto;
  }

  .purchase-offers__nutrition-content {
    margin-block-start: var(--margin-lg);
  }

  .purchase-offers__nutrition-close {
    position: absolute;
    inset-block-start: var(--padding-md);
    inset-inline-end: var(--padding-md);
  }

  /* Add to cart */
  .purchase-offers__buttons {
    display: grid;
  }

  .purchase-offers__cta {
    width: 100%;
  }

  .purchase-offers__guarantee {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--gap-2xs);
    margin: 0;
    color: var(--purchase-offers-muted);
    font-size: var(--font-size--sm);
  }

  .purchase-offers__guarantee .svg-wrapper svg {
    width: 1em;
    height: 1em;
  }

  .purchase-offers__supporting {
    color: var(--purchase-offers-muted);
    font-size: var(--font-size--xs);
    text-align: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Purchase offers",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Offers are built from the current product. A product with multiple variants shows one offer per variant; a single-variant product shows quantity tiers. Subscription pricing comes from the product's first selling plan group."
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Choose Your Offer"
    },
    {
      "type": "header",
      "content": "Purchase type"
    },
    {
      "type": "text",
      "id": "subscribe_label",
      "label": "Subscription label",
      "default": "Subscribe & Save"
    },
    {
      "type": "text",
      "id": "subscribe_note",
      "label": "Subscription sublabel",
      "info": "Optional second line under the subscription label."
    },
    {
      "type": "text",
      "id": "one_time_label",
      "label": "One-time label",
      "default": "One-Time"
    },
    {
      "type": "select",
      "id": "default_plan",
      "label": "Default purchase type",
      "options": [
        { "value": "subscription", "label": "Subscription" },
        { "value": "onetime", "label": "One-time" }
      ],
      "default": "subscription",
      "info": "Falls back to one-time when the product has no selling plans."
    },
    {
      "type": "text",
      "id": "frequency_label",
      "label": "Delivery frequency label",
      "default": "Delivery frequency",
      "info": "Only shown when the subscription has more than one frequency."
    },
    {
      "type": "text",
      "id": "plan_legend",
      "label": "Purchase type group label",
      "default": "Choose a purchase type",
      "info": "Read by screen readers."
    },
    {
      "type": "header",
      "content": "Offers"
    },
    {
      "type": "range",
      "id": "offer_count",
      "label": "Offers to show",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    },
